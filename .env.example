# ===== 必填 =====
# 通义千问（DashScope）：仅在 EMBEDDING_BACKEND=dashscope 时用于向量化
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek：默认的问答大模型（LLM_PROVIDER=deepseek 时必填）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== 可选：模型 =====
# deepseek | dashscope（dashscope 时使用通义千问 qwen-plus 生成）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ===== 可选：向量化 =====
# dashscope | sentence-transformers
# dashscope：云端 text-embedding-*，开箱可用，需要 DASHSCOPE_API_KEY
# sentence-transformers：本地跑，不联网、文档不出机器；
#   需要 pip install -r requirements-embedding.txt，并把 EMBEDDING_MODEL 指向本地权重的绝对路径
#   注意：路径必须是「跑代码的那个 python」看得见的，否则 transformers 不报错，
#   会把它当 HF 仓库名去联网下载，然后静默卡住
EMBEDDING_BACKEND=dashscope
EMBEDDING_MODEL=text-embedding-v1
# 本地模型才有意义：cpu / cuda
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# CPU 上这是唯一值得调的参数：本机 12→16 线程，吞吐 259→579 字/秒
EMBEDDING_NUM_THREADS=
# 归一化后再算余弦：bge 系列按此训练，关掉会让分数分布整体偏移
EMBEDDING_NORMALIZE=true
# 留空则用模型自带的最大长度
EMBEDDING_MAX_SEQ_LENGTH=

# ===== 安全 =====
# 设置了之后，/api/v1/*（健康检查除外）必须携带请求头 X-API-Key
# 例如：curl -H "X-API-Key: your-key" http://localhost:8000/api/v1/query
API_KEY=
# CORS 白名单，逗号分隔。对外部署时改成你自己的域名
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===== 可选：切片 =====
# auto：能认出条文号就按「第 X.X.X 条」切（规范类语料），认不出退回定长
CHUNK_MODE=auto
# 判定「这是规范」的双条件：行首条文号个数 AND 行占比。
# 只看个数会把实践日志里「1.21 地点……」这种日期行误判成条文。
ARTICLE_MIN_MARKERS=12
ARTICLE_MIN_DENSITY=0.06
# 单条过长才二次切分
ARTICLE_MAX_CHARS=1200
ARTICLE_SUB_OVERLAP=80
# 以下两条只对定长口径生效
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# 完全一致的跨标准重复切片才合并；近重复只报告，不合并
DEDUPE_ENABLED=true
DEDUPE_THRESHOLD=0.90
MAX_UPLOAD_MB=20

# ===== 可选：检索 =====
# vector | bm25 | hybrid_sum | hybrid_rrf | vector_rerank | hybrid_rrf_rerank
# 默认 RRF：hit@6 与加权和相同但 MRR 更好；重排档质量最高，代价是 p95 约 11.5s
RETRIEVAL_MODE=hybrid_rrf
# 每一路的召回深度，也是最终保留深度（所有档位对齐，消融才对得上）
RECALL_CANDIDATES=20
RRF_K=60
BM25_K1=1.5
BM25_B=0.75
# 只作用于 hybrid_sum 档
BM25_WEIGHT=0.5
BM25_INDEX_PATH=./data/bm25_index.pkl

# ===== 可选：重排（装了 requirements-rerank.txt 才生效）=====
RERANK_MODEL=models/bge-reranker-v2-m3
# int8 ONNX 目录存在时优先走 onnxruntime（2.27GB → 568MB，延迟只快 5~10%）
RERANK_ONNX_PATH=
RERANK_DEVICE=cpu
# 按切片长度分布定：中位 502 / p90 574。给 256 会让重排看不到答案
RERANK_MAX_LENGTH=640
RERANK_BATCH_SIZE=8
RERANK_TOP_N=20
# 0 = 不设延迟预算；非 0 时超预算整档跳过重排
RERANK_BUDGET_MS=0
RERANK_MIN_CANDIDATES=5
# 模型缺失或推理报错时安静降级为融合顺序：检索可用性优先于排序质量
RERANK_FAIL_OPEN=true

# ===== 可选：喂给模型的片段数 =====
# 6 而不是 4：n11 的正确答案稳定排第 5，k=4 直接截断，模型看不到原文就拒答
TOP_K=6
# 查询级闸门：top1 低于它直接拒答、不调模型（0 表示关闭）。
# 别指望它兜幻觉——这批语料里无答案题的 top1 分与有答案题完全重叠，
# 抬到 0.65 幻觉一例没少，却白赔 4 道能答对的题。
MIN_SCORE=0.30

# ===== 可选：存储 =====
DATA_DIR=./data
CHROMA_DIR=./chroma_db
COLLECTION_NAME=kb_documents
LOG_LEVEL=INFO
